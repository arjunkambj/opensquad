# OpenSquad environment configuration — names and placeholders only.
# Copy to `.env.local` (gitignored via `*.local`) and fill in real values.
#
# Legend for where each value is supplied:
#   [local]    developer `.env.local` on this machine
#   [vite]     bundled into the frontend build — PUBLIC values only, never secrets
#   [convex]   Convex deployment env var — set with `pnpm exec convex env set NAME`
#              (https://docs.convex.dev/production/environment-variables),
#              never prefixed `VITE_` unless it is genuinely public config
#   [worker]   injected into the ASCII Box by the runtime provisioning flow (P07);
#              never stored in this repo or committed
#   [release]  release tooling only — never in the frontend build or a Box

# ---------------------------------------------------------------------------
# Frontend / Vite build configuration (public project config — not secrets)
# ---------------------------------------------------------------------------

# [local] [vite] Convex client endpoint of the selected development deployment,
# e.g. https://<deployment>.convex.cloud — from the Convex dashboard.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# [local] [vite] Convex HTTP actions endpoint of the same deployment,
# e.g. https://<deployment>.convex.site — used for worker/webhook URLs.
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# [local] [vite] [convex] Hexclave project ID (public identifier).
# Owner supplies it from the Hexclave dashboard project settings.
# ALSO set on the Convex deployment (`convex env set VITE_HEXCLAVE_PROJECT_ID`):
# `convex/auth.config.ts` reads it on the backend to configure JWT verification.
VITE_HEXCLAVE_PROJECT_ID=your-hexclave-project-id

# [local] [vite] Hexclave publishable client key (public, safe in the bundle).
# Owner supplies it from the Hexclave dashboard API-keys section.
VITE_HEXCLAVE_PUBLISHABLE_CLIENT_KEY=pck_your_publishable_client_key

# [local] Hexclave secret server key — SERVER-ONLY, never `VITE_*`, never in a
# Box. Only needed for server-side Hexclave API calls (e.g. user management);
# the browser sign-in flow does not use it. From the Hexclave dashboard.
HEXCLAVE_SECRET_SERVER_KEY=ssk_your_secret_server_key

# ---------------------------------------------------------------------------
# Local Convex CLI
# ---------------------------------------------------------------------------

# [local] Selects the development deployment for `convex` CLI commands.
# Format `dev:<deployment-name>` (or `prod:` for production). Do not overwrite
# an existing selection to create an anonymous project.
CONVEX_DEPLOYMENT=dev:your-deployment-name

# ---------------------------------------------------------------------------
# Convex deployment settings (server-only — `pnpm exec convex env set NAME`)
# These never appear in `.env.local` for backend use and must never use VITE_*.
# ---------------------------------------------------------------------------

# [convex] ASCII Box API service key for runtime provisioning (P03/P07).
# Owner creates it with `box api-key create` or the ASCII dashboard.
# Application service key only — never passed into customer Boxes.
ASCII_API_KEY=box_your_ascii_api_key

# [convex] Firecrawl API key for the backend-owned research component (P04/P09).
# Owner supplies it from the Firecrawl dashboard.
FIRECRAWL_API_KEY=fc-your_firecrawl_api_key

# [convex] Firecrawl webhook signing secret for `/firecrawl/*` callbacks.
# Owner generates/configures it alongside the Firecrawl component.
FIRECRAWL_WEBHOOK_SECRET=your_firecrawl_webhook_secret

# [convex] AgentMail API key used by the mail component and the narrow send
# adapter (P05/P10/P11). Owner supplies it from the AgentMail dashboard.
AGENTMAIL_API_KEY=am_your_agentmail_api_key

# [convex] AgentMail webhook secret verifying Svix signatures on
# `/agentmail/webhook`. From the AgentMail dashboard webhook configuration.
AGENTMAIL_WEBHOOK_SECRET=whsec_your_agentmail_webhook_secret

# ---------------------------------------------------------------------------
# Convex demo policy (server-only — `convex env set`); absence disables
# public-demo sending. Normal workspace owners cannot expand these.
# ---------------------------------------------------------------------------

# [convex] Comma-separated normalized recipient addresses allowed for
# public-demo sends (P16). Owner maintains the controlled list.
OPENSQUAD_DEMO_ALLOWED_RECIPIENTS=demo-recipient1@example.test,demo-recipient2@example.test

# [convex] Hard cap on public-demo sends per day, e.g. "5".
OPENSQUAD_DEMO_MAX_DAILY_SENDS=5

# [convex] Feature flags for the P16 public demo surface. BOTH default OFF:
# absence means `demo.tour` answers `{enabled:false}` and `demo.optIn` rejects.
#   OPENSQUAD_DEMO_TOUR=1       — serves the sanitized read-only tour (prepared
#                                 content only; never reads workspace tables).
#   OPENSQUAD_DEMO_EXECUTION=1  — lets a signed-in visitor create their own
#                                 isolated demoMode workspace (quotas below).
OPENSQUAD_DEMO_TOUR=0
OPENSQUAD_DEMO_EXECUTION=0

# ---------------------------------------------------------------------------
# Runtime provisioning — injected into each workspace's ASCII Box by the
# provisioning flow (P07). Workspace-scoped credential, NOT a deploy key.
# ---------------------------------------------------------------------------

# [worker] Bridge origin: the deployment's `.convex.site` HTTP endpoint the
# worker polls for control commands and posts results to.
OPENSQUAD_BRIDGE_URL=https://your-deployment.convex.site

# [worker] Runtime identity for this Box/worker, assigned by the bridge.
OPENSQUAD_RUNTIME_ID=runtime_id_from_bridge

# [worker] Runtime generation; stale generations are rejected after recovery.
OPENSQUAD_RUNTIME_GENERATION=1

# [worker] Scoped worker credential issued by the bridge; grants only the
# allowed claim/heartbeat/result operations for this workspace+generation.
OPENSQUAD_WORKER_TOKEN=osw_your_scoped_worker_token

# ---------------------------------------------------------------------------
# Release tooling only (P16) — never in the frontend build or a Box.
# ---------------------------------------------------------------------------

# [release] Convex deploy key for the chosen release flow, if it needs one.
# Owner creates it in the Convex dashboard deployment settings. Not needed for
# ordinary development; `convex dev` uses the logged-in CLI identity.
CONVEX_DEPLOY_KEY=prod:your_deploy_key_only_if_required
