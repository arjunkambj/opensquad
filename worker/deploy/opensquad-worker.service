# OpenSquad worker — systemd unit for inside the ASCII Box (P03 spike, P07 image).
#
# Install as: /etc/systemd/system/opensquad-worker.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now opensquad-worker
#
# Expectations (see worker/RUNTIME.md):
#   - dedicated unprivileged user `opensquad` with home /var/lib/opensquad
#   - worker bundle at /opt/opensquad/worker (dist/ + node_modules + package.json)
#   - pinned Node 24 LTS on PATH (built image: /usr/local/bin/node)
#   - pinned @openai/codex 0.154.0 binary on PATH (`codex`)
#   - /etc/opensquad/worker.env (0600, owned by opensquad) carries only the four
#     OPENSQUAD_* names from worker/.env.example — no provider secrets

[Unit]
Description=OpenSquad worker (Codex App Server stdio supervisor)
After=network-online.target
Wants=network-online.target
# A permanently broken image/binary must not restart every 5 s forever —
# after 5 rapid failures the unit stays failed (the honest state) until an
# operator or reprovisioning intervenes.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=opensquad
Group=opensquad
EnvironmentFile=/etc/opensquad/worker.env
WorkingDirectory=/var/lib/opensquad
ExecStart=/usr/bin/env node /opt/opensquad/worker/dist/main.js
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5
# Box stop/resume restarts enabled units; the worker must re-verify account
# state on every start (managed login cache lives in CODEX_HOME under this
# service user only).
Environment=CODEX_HOME=/var/lib/opensquad/.codex
StateDirectory=opensquad
StateDirectoryMode=0700

# Hardening (starting point — validated inside the real Box in P03/P07):
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/opensquad /opt/opensquad/worker
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# The worker speaks only outbound HTTPS to the Convex bridge; the App Server
# child stays on stdio and is never exposed on a port.
LockPersonality=true

[Install]
WantedBy=multi-user.target
