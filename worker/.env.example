# OpenSquad worker runtime configuration — names and placeholders only.
#
# These variables are injected into the workspace's ASCII Box by the runtime
# provisioning flow (implemented in P07). They are workspace-scoped runtime
# credentials: a worker token is NOT a Convex deploy key and grants only the
# allowed claim/heartbeat/control/result operations for one runtime generation.
# Never commit real values, and never inject provider secrets
# (ASCII_API_KEY, AGENTMAIL_*, FIRECRAWL_*, OPENAI_API_KEY) into a Box —
# provider credentials stay in Convex or the trusted tool gateway.

# Bridge origin: the deployment's `.convex.site` HTTP endpoint this worker
# polls for owner-control commands and posts heartbeats/results to.
OPENSQUAD_BRIDGE_URL=https://your-deployment.convex.site

# Runtime identity assigned by the bridge for this Box/worker.
OPENSQUAD_RUNTIME_ID=runtime_id_from_bridge

# Runtime generation; incremented on recovery so stale completions are
# rejected by the backend.
OPENSQUAD_RUNTIME_GENERATION=1

# Scoped worker credential issued by the bridge (hashed at rest).
OPENSQUAD_WORKER_TOKEN=osw_your_scoped_worker_token

# ---------------------------------------------------------------------------
# Pinned runtime suggested by P01 (P03 validates inside a real Box):
#   - Node.js 24 LTS, e.g. Docker reference `node:24.21.0-bookworm-slim`
#     or Node 24.21.0 installed in a clean named ASCII snapshot
#   - `@openai/codex@0.154.0` (npm wrapper; resolves
#     `@openai/codex-linux-x64@0.154.0` in a Linux Box)
#   - Codex App Server runs over stdio as a child of the worker; generate
#     protocol types from the installed binary:
#       codex app-server generate-ts --out worker/src/generated/codex
#       codex app-server generate-json-schema --out worker/protocol
#       codex app-server --stdio
# Boxes are created with `noEnv: true` and an explicit `ttlSeconds`; the
# workspace owner's managed Codex login happens inside the Box, never via
# copied builder credentials.
